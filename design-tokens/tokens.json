{
  "$description": "Conducir J&R del Sinú · tokens de diseño generados desde DESIGN.md con los ajustes aprobados (14 oct 2026): hover #00502C (paleta del logo) y franja a 30°. Formato DTCG ($value/$type), compatible con Style Dictionary v4.",
  "color": {
    "$type": "color",
    "brand": {
      "default": {
        "$value": "#005932",
        "$description": "Verde Sinú. Único color de acción: botón principal, links, menú activo, eyebrows, checks y foco."
      },
      "hover": {
        "$value": "#00502C",
        "$description": "Verde Profundo. Hover y pressed del botón principal y de links. Sustituye a #00472A de DESIGN.md (ajuste aprobado: sale del logo)."
      },
      "bright": {
        "$value": "#00AA4C",
        "$description": "Verde Pista. Solo decorativo: degradado, aguada y tramo Manejo del arco. Nunca texto (2.9:1)."
      },
      "lime": {
        "$value": "#9BC844",
        "$description": "Lima Velocímetro. Solo decorativo: arcos internos, tramo Taller del arco, aguada, comillas. Nunca texto (1.8:1)."
      },
      "glow": {
        "$value": "#E8F3D6",
        "$description": "Brillo Lima. Círculos de íconos y lavados atmosféricos. Nunca fondo de sección."
      }
    },
    "ribbon": {
      "default": {
        "$value": "#F10825",
        "$description": "Rojo Franja. Solo la franja firma, texto blanco bold ≥ 19 px (4.37:1)."
      },
      "small": {
        "$value": "#C71424",
        "$description": "Rojo Aguja. Franja pequeña (texto < 19 px, 5.9:1) y aguja del velocímetro."
      }
    },
    "neutral": {
      "canvas": {
        "$value": "#FDFBF7",
        "$description": "Blanco Cálido. Fondo de todas las páginas, menú y footer."
      },
      "surface": {
        "$value": "#FFFFFF",
        "$description": "Papel. Tarjetas, paneles y aviso de privacidad."
      },
      "text": {
        "$value": "#1D1E1C",
        "$description": "Tinta. Texto principal e íconos (16.2:1 sobre Blanco Cálido)."
      },
      "text-muted": { "$value": "#615F5C", "$description": "Piedra. Texto secundario (6.2:1)." },
      "text-disabled": {
        "$value": "#8E8B87",
        "$description": "Madera. Trazos decorativos y deshabilitados. No texto informativo (3.3:1)."
      },
      "border-strong": {
        "$value": "#C0BBB6",
        "$description": "Hueso. Bordes de controles en reposo."
      },
      "border": {
        "$value": "#E4DFD3",
        "$description": "Niebla. Divisores, líneas finas y fondo de botón deshabilitado."
      }
    },
    "feedback": {
      "error": {
        "$value": "#B42318",
        "$description": "Mensajes de error, siempre con ícono y texto (6.2:1)."
      }
    },
    "course": {
      "theory": {
        "$value": "{color.brand.default}",
        "$description": "Tramo Teoría del arco (excepción documentada)."
      },
      "workshop": {
        "$value": "{color.brand.lime}",
        "$description": "Tramo Taller del arco (excepción documentada)."
      },
      "driving": {
        "$value": "{color.brand.bright}",
        "$description": "Tramo Manejo del arco (excepción documentada)."
      }
    }
  },
  "gradient": {
    "car": {
      "$value": "linear-gradient(90deg, #00502C 36.9%, #00793C 67.8%, #008941 77.7%, #00AA4C 95.7%)",
      "$description": "Degradado del auto del logo, 90° de la nariz a la cola. Paradas: #00502C 36.9 %, #00793C 67.8 %, #008941 77.7 %, #00AA4C 95.7 %."
    },
    "hero-wash": {
      "$value": "linear-gradient(110deg, #005932 0%, #00AA4C 55%, #9BC844 100%)",
      "$description": "Aguada del hero: forma orgánica difuminada (blur ~18–22 px), nunca detrás de texto."
    }
  },
  "opacity": {
    "$type": "number",
    "hero-wash": { "$value": 0.24, "$description": "Rango permitido 0.18–0.30." }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": ["Barlow Condensed", "Arial Narrow", "sans-serif"],
        "$description": "Solo H1 del hero y títulos de página. Itálica 800, MAYÚSCULAS. Un titular por pantalla."
      },
      "body": { "$value": ["Barlow", "system-ui", "sans-serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "extrabold": { "$value": 800 }
    },
    "size": {
      "$type": "dimension",
      "caption": { "$value": "13px" },
      "small": { "$value": "14px" },
      "body": { "$value": "16px" },
      "body-lg": { "$value": "18px" },
      "heading-sm": { "$value": "20px" },
      "heading": { "$value": "24px" },
      "heading-lg": { "$value": "32px" },
      "section": { "$value": "40px" },
      "display": { "$value": "56px" },
      "display-lg": { "$value": "72px" },
      "display-mobile": { "$value": "40px", "$description": "Rango móvil 36–44 px." },
      "section-mobile": { "$value": "28px" },
      "ribbon": { "$value": "22px", "$description": "Mínimo 19 px sobre Rojo Franja." },
      "ribbon-small": { "$value": "14px" }
    },
    "line-height": {
      "$type": "number",
      "display": { "$value": 0.98 },
      "heading": { "$value": 1.12 },
      "body": { "$value": 1.55 }
    },
    "letter-spacing": {
      "$type": "dimension",
      "display": { "$value": "0em" },
      "heading": { "$value": "-0.01em" },
      "body": { "$value": "0.015em" },
      "eyebrow": { "$value": "0.06em" },
      "ribbon": { "$value": "0.04em" }
    }
  },
  "typography": {
    "$type": "typography",
    "display": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": "{font.weight.extrabold}",
        "fontSize": "{font.size.display-lg}",
        "lineHeight": "{font.line-height.display}",
        "letterSpacing": "{font.letter-spacing.display}"
      },
      "$description": "Itálica + MAYÚSCULAS."
    },
    "display-mobile": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": "{font.weight.extrabold}",
        "fontSize": "{font.size.display-mobile}",
        "lineHeight": "{font.line-height.display}",
        "letterSpacing": "{font.letter-spacing.display}"
      }
    },
    "section": {
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontWeight": "{font.weight.semibold}",
        "fontSize": "{font.size.section}",
        "lineHeight": "{font.line-height.heading}",
        "letterSpacing": "{font.letter-spacing.heading}"
      }
    },
    "heading": {
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontWeight": "{font.weight.semibold}",
        "fontSize": "{font.size.heading}",
        "lineHeight": "{font.line-height.heading}",
        "letterSpacing": "{font.letter-spacing.body}"
      }
    },
    "eyebrow": {
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontWeight": "{font.weight.bold}",
        "fontSize": "{font.size.small}",
        "lineHeight": "{font.line-height.body}",
        "letterSpacing": "{font.letter-spacing.eyebrow}"
      },
      "$description": "MAYÚSCULAS, color brand.default."
    },
    "body": {
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontWeight": "{font.weight.regular}",
        "fontSize": "{font.size.body}",
        "lineHeight": "{font.line-height.body}",
        "letterSpacing": "{font.letter-spacing.body}"
      }
    },
    "button": {
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontWeight": "{font.weight.semibold}",
        "fontSize": "{font.size.body}",
        "lineHeight": 1,
        "letterSpacing": "{font.letter-spacing.body}"
      }
    },
    "ribbon": {
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontWeight": "{font.weight.bold}",
        "fontSize": "{font.size.ribbon}",
        "lineHeight": 1,
        "letterSpacing": "{font.letter-spacing.ribbon}"
      },
      "$description": "MAYÚSCULAS, blanco."
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" },
    "20": { "$value": "80px" },
    "28": { "$value": "112px" }
  },
  "layout": {
    "$type": "dimension",
    "container-max": { "$value": "1200px" },
    "gutter-mobile": { "$value": "16px" },
    "gutter-desktop": { "$value": "32px" },
    "section-gap-mobile": { "$value": "48px" },
    "section-gap-desktop": { "$value": "80px" },
    "card-padding-mobile": { "$value": "24px" },
    "card-padding-desktop": { "$value": "40px" },
    "reading-width": { "$value": "720px", "$description": "Columna de la Política de datos." },
    "section-header-width": { "$value": "700px" }
  },
  "size": {
    "$type": "dimension",
    "touch-target": { "$value": "44px" },
    "button-height": { "$value": "48px" },
    "button-height-mobile": { "$value": "52px" },
    "nav-height": {
      "$value": "124px",
      "$description": "Arriba de la página, con el logo completo."
    },
    "nav-height-compact": {
      "$value": "72px",
      "$description": "Con scroll > 80 px, con el logo-ícono."
    },
    "nav-height-mobile": { "$value": "64px" },
    "logo-min-width": { "$value": "240px" },
    "logo-icon-min-width": { "$value": "80px" },
    "fab": { "$value": "56px" },
    "icon-circle": { "$value": "64px" },
    "icon-circle-small": { "$value": "48px" },
    "notice-max-width": { "$value": "360px" },
    "ribbon-height": { "$value": "48px" },
    "ribbon-height-small": { "$value": "30px" }
  },
  "radius": {
    "$type": "dimension",
    "button": { "$value": "16px" },
    "input": { "$value": "16px" },
    "image": { "$value": "16px" },
    "accordion": { "$value": "16px" },
    "card": { "$value": "20px" },
    "pill": { "$value": "999px" },
    "ribbon": { "$value": "0px", "$description": "Paralelogramo sin radio." }
  },
  "angle": {
    "ribbon-skew": {
      "$value": "30deg",
      "$description": "Desplazamiento horizontal = 0.577 × alto; se dibuja con clip-path para que el texto no se incline (ajuste aprobado; DESIGN.md decía −12°)."
    },
    "hero-card-tilt": {
      "$value": "2deg",
      "$description": "Alternando −2° / +2°. Sin rotación en móvil."
    }
  },
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": {
        "color": "rgba(29, 30, 28, 0.16)",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "4px",
        "spread": "0px"
      },
      "$description": "Botón principal."
    },
    "lg": {
      "$value": {
        "color": "rgba(0, 89, 50, 0.14)",
        "offsetX": "6px",
        "offsetY": "4px",
        "blur": "24px",
        "spread": "0px"
      },
      "$description": "Tarjetas flotantes y destacadas."
    },
    "lg-hover": {
      "$value": {
        "color": "rgba(0, 89, 50, 0.18)",
        "offsetX": "8px",
        "offsetY": "8px",
        "blur": "32px",
        "spread": "0px"
      },
      "$description": "Hover de tarjeta (DESIGN.md: 'sombra un poco mayor')."
    }
  },
  "focus": {
    "color": { "$type": "color", "$value": "{color.brand.default}" },
    "width": { "$type": "dimension", "$value": "2px" },
    "offset": { "$type": "dimension", "$value": "3px" },
    "offset-link": { "$type": "dimension", "$value": "2px" }
  },
  "breakpoint": {
    "$type": "dimension",
    "mobile": { "$value": "390px", "$description": "Ancho de diseño móvil." },
    "layout": {
      "$value": "720px",
      "$description": "Cambio de disposición móvil ↔ escritorio usado en los mockups."
    },
    "desktop": { "$value": "1440px", "$description": "Ancho de diseño de escritorio." }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "150ms", "$description": "Cambio de color de botones." },
      "nav": { "$value": "200ms", "$description": "Menú a modo compacto; giro del chevron." },
      "enter": { "$value": "300ms", "$description": "Entrada de tarjetas." },
      "stagger": { "$value": "60ms" },
      "arc": {
        "$value": "600ms",
        "$description": "Redistribución de tramos al cambiar de categoría."
      },
      "needle": { "$value": "900ms", "$description": "Barrido de la aguja en la primera carga." },
      "copied": { "$value": "2000ms", "$description": "Tiempo del estado 'Copiado'." }
    },
    "easing": {
      "$type": "cubicBezier",
      "out": { "$value": [0.2, 0.8, 0.2, 1] }
    },
    "distance": {
      "$type": "dimension",
      "enter": { "$value": "12px" }
    }
  }
}
