{
  "name": "conducirjrdelsinu-web",
  "private": true,
  "version": "0.1.0",
  "description": "Sitio web informativo de Conducir J&R del Sinú, Centro de Enseñanza Automovilística en Cereté, Córdoba.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run tokens && vite --mode development",
    "tokens": "tsx scripts/build-tokens.ts",
    "tokens:check": "tsx scripts/build-tokens.ts --check",
    "svg:optimize": "svgo -r -f public/assets --config svgo.config.js",
    "build": "npm run build:production",
    "build:qa": "npm run tokens && vite build --mode qa && vite build --mode qa --ssr src/entry-server.tsx --outDir dist-server && tsx scripts/prerender.ts --mode qa && tsx scripts/generate-env-files.ts --mode qa",
    "build:production": "npm run tokens && vite build --mode production && vite build --mode production --ssr src/entry-server.tsx --outDir dist-server && tsx scripts/prerender.ts --mode production && tsx scripts/generate-env-files.ts --mode production",
    "preview:qa": "npm run build:qa && tsx scripts/serve-dist.ts",
    "preview:production": "npm run build:production && tsx scripts/serve-dist.ts",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.tests.json",
    "lint": "npm run tokens:check && npm run lint:js && npm run lint:css && npm run format:check",
    "lint:js": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\" --allow-empty-input",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:validate": "tsx scripts/validate-content.ts",
    "test:unit": "vitest run --project unit --coverage",
    "test:components": "vitest run --project components",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit --project=mobile",
    "test:e2e:qa": "BASE_URL=https://qa.conducirjrdelsinu.pages.dev playwright test --project=chromium --project=firefox --project=webkit --project=mobile",
    "test:e2e:smoke": "BASE_URL=https://conducirjrdelsinu.pages.dev playwright test --project=smoke",
    "test:visual": "playwright test --project=visual --pass-with-no-tests",
    "test:visual:update": "playwright test --project=visual --pass-with-no-tests --update-snapshots",
    "test": "npm run test:unit && npm run test:components && npm run build:qa && npm run test:e2e && npm run test:visual",
    "serve": "tsx scripts/serve-dist.ts"
  },
  "dependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@tanstack/react-query": "5.104.0",
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "style-dictionary": "5.6.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-value-no-unknown-custom-properties": "6.1.1",
    "svgo": "4.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
