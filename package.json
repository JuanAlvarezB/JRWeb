{
  "name": "conducirjrdelsinu-web",
  "private": true,
  "version": "0.1.0",
  "description": "Sitio web informativo de Conducir J&R del Sinú, Centro de Enseñanza Automovilística en Cereté, Córdoba.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run tokens && vite --mode development",
    "tokens": "tsx scripts/build-tokens.ts",
    "tokens:check": "tsx scripts/build-tokens.ts --check",
    "svg:optimize": "svgo -r -f public/assets --config svgo.config.js",
    "build": "npm run build:production",
    "build:qa": "npm run tokens && vite build --mode qa && tsx scripts/generate-env-files.ts --mode qa",
    "build:production": "npm run tokens && vite build --mode production && tsx scripts/generate-env-files.ts --mode production",
    "preview:qa": "npm run build:qa && vite preview --mode qa",
    "preview:production": "npm run build:production && vite preview --mode production",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "npm run tokens:check && npm run lint:js && npm run lint:css && npm run format:check",
    "lint:js": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\" --allow-empty-input",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "style-dictionary": "5.6.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-value-no-unknown-custom-properties": "6.1.1",
    "svgo": "4.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  }
}
