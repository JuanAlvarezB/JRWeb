# Plantilla de variables de entorno.
# REGLA: aquí solo van valores PÚBLICOS. Todo lo que empieza por VITE_ termina
# dentro del JavaScript que descarga el visitante. Nunca pongas contraseñas,
# llaves ni tokens privados en estos archivos: el repositorio es público.

# Nombre del ambiente: development | qa | production
VITE_ENV_NAME=development

# URL pública del propio ambiente (sin barra final)
VITE_SITE_URL=http://localhost:5173

# Token PÚBLICO del beacon de Cloudflare Web Analytics. Solo en producción.
# En PDN lo inyecta GitHub Actions desde la variable del environment "production".
VITE_CF_ANALYTICS_TOKEN=
