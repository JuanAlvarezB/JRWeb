# Dependencias y builds
node_modules/
dist/
dist-server/
*.tsbuildinfo

# Reportes de pruebas
coverage/
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Variables locales (nunca se suben; los .env.[modo] solo tienen valores públicos)
.env.local
.env.*.local
*.local

# Insumos de diseño originales (los assets necesarios se copian a public/ y docs/)
insumos/

# Sistema y editores
.DS_Store
*.log
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Herramientas locales de Claude Code
.claude/
.agents/
skills-lock.json
docs/*
# Documentos del proyecto (sí se versionan); el resto de docs/ son notas locales.
!docs/mockups/
!docs/ambientes-y-despliegue.md
!docs/checklist-pruebas-manuales-qa.md
!docs/configuracion-cloudflare.md
!docs/configuracion-github.md
!docs/estado-del-proyecto.md
!docs/guia-actualizar-contenido.md
!docs/instalacion-local.md
!docs/pendientes.md

# Capturas de regresión visual hechas fuera de Linux: las de referencia salen del CI
# (workflow "Actualizar capturas de referencia").
tests/e2e/specs/visual/**/*-darwin.png
tests/e2e/specs/visual/**/*-win32.png
