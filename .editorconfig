root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Verificación de Google Search Console: contenido exacto, sin salto de línea final.
[public/google*.html]
insert_final_newline = false
trim_trailing_whitespace = false
